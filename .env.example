# Proveedor del modelo. Valores: openrouter, openai_compatible, bedrock, ollama, gemini
PROVEEDOR_MODELO=openrouter

# OpenRouter (default)
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=openai/gpt-4o-mini
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI-compatible (Groq, Together, vLLM, etc.)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL_ID=

# Bedrock
BEDROCK_MODEL_ID=
AWS_REGION=us-east-2

# Ollama (si el contenedor usa Ollama en el host, usa http://host.docker.internal:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=llama3.1

# Gemini
GEMINI_API_KEY=

# Kira
KIRA_DATA_DIR=./data
KIRA_DB1_PATH=./data/db_1_business.sqlite3
KIRA_DB2_PATH=./data/db_2_sessions.sqlite3
KIRA_TIMEZONE=America/Bogota
KIRA_BUSINESS_NAME=Estudio Kira
KIRA_AGENT_ID=kira
KIRA_LOG_LEVEL=INFO
